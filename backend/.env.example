# Natyaa AI - Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=natyaa_ai

# Security & JWT
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100

# Email Notification Settings (SMTP)
# To use Gmail: Set SMTP_USER=your_email@gmail.com and SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=NATYA AI <notifications@natyaai.com>
SMTP_FROM_NAME=NATYA AI
SMTP_ENABLED=True
